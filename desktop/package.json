{
  "name": "academy-skills",
  "productName": "Academy Skills",
  "version": "1.0.0",
  "description": "Самообучающаяся академия навыков для Claude",
  "author": "Academy Skills",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "sync": "node sync-site.js",
    "start": "npm run sync && electron .",
    "dist:win": "npm run sync && electron-builder --win nsis --x64",
    "dist:mac": "npm run sync && electron-builder --mac dmg --universal",
    "dist:linux": "npm run sync && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "app.academyskills.desktop",
    "productName": "Academy Skills",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Academy Skills",
      "artifactName": "Academy-Skills-Setup-${version}.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "Academy-Skills-${version}.dmg"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Education",
      "maintainer": "Academy Skills",
      "artifactName": "Academy-Skills-${version}.${ext}"
    },
    "publish": null
  }
}
